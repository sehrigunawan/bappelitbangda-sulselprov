# Example only. Copy to .env and edit. Never put real secrets or real data here.
API_PORT=8080
WEB_PORT=5173
# Web server -> Go API (server-side calls from SvelteKit)
API_INTERNAL_URL=http://localhost:8080
# Runtime role of the API (development value; created by `make db-init`)
DATABASE_URL=postgres://app:app@localhost:5432/bappelitbangda_dev?sslmode=disable
# Role that runs migrations (development value)
MIGRATE_URL=postgres://migrator:migrator@localhost:5432/bappelitbangda_dev?sslmode=disable
# --- auth & keyring ---
# KEK file is relative to api/, the cwd of `go run ./cmd/api`.
# Generate for dev with: mkdir -p secrets && printf 'dev-1 %s\n' "$(head -c 32 /dev/urandom | base64)" > secrets/kek
KEK_FILE=../secrets/kek
KEK_ACTIVE_ID=dev-1
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TIMEOUT=30m
AUTH_SESSION_LIFETIME=12h
AUTH_PENDING_TTL=10m
AUTH_STEP_UP_TTL=10m
AUTH_THROTTLE_FAILURES=5
AUTH_THROTTLE_BASE_DELAY=15m
AUTH_THROTTLE_MAX_DELAY=24h
AUTH_TRUST_PROXY_HEADER=false
