# Example environment file for .env.production / .env.staging on the VPS (mode 0600, never in the repo).
# FAKE VALUES. Real passwords are generated on the server; the key-encryption key (KEK) is a separate file secret.
# Compose service names differ per profile: staging uses db-staging / api-staging; the network aliases "api" and "web" are the same.

# --- PostgreSQL container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bappelitbangda

# --- migrate job (goose) ---
GOOSE_DRIVER=postgres
# production host is "db"; staging host is "db-staging"
GOOSE_DBSTRING=postgres://postgres:change-me@db-staging:5432/bappelitbangda?sslmode=disable

# --- api ---
API_PORT=8080
# production host is "db"; staging host is "db-staging"; role "app" per the runbook
DATABASE_URL=postgres://app:change-me-app@db-staging:5432/bappelitbangda?sslmode=disable
KEK_FILE=/run/secrets/kek
KEK_ACTIVE_ID=kek-1
AUTH_TRUST_PROXY_HEADER=true
# Set false only on a staging host served over plain http; nginx has no TLS yet, see known-gaps.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_IDLE_TIMEOUT=30m
AUTH_SESSION_LIFETIME=12h
AUTH_PENDING_TTL=10m
AUTH_STEP_UP_TTL=10m
AUTH_THROTTLE_FAILURES=5
AUTH_THROTTLE_BASE_DELAY=15m
AUTH_THROTTLE_MAX_DELAY=24h

# --- web (adapter-node behind nginx) ---
PORT=3000
API_INTERNAL_URL=http://api:8080
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
